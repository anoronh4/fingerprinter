/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/fingerprinter'
    input = "${projectDir}/tests/test_data/input.csv"
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

process {
    withName: 'CUSTOM_FINGERPRINTCOMBINE' {
        ext.args = "-d 0"
    }

    withName: 'CUSTOM_FINGERPRINTCONTAMINATION' {
        ext.args = "-d 0"
    }

    withName: 'CUSTOM_FINGERPRINTVCFPARSER' {
        ext.args = "-d 0"
    }
}
